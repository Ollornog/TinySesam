# Dependabot Auto-Merge — aus der Vorlage von repokit (`repokit automerge`), nicht von Hand ändern.
# Je Repo frei ist nur der Block zwischen „je Repo: Anfang“ und „je Repo: Ende“; den Rest prüft
# `tests/_kit/automerge.py` gegen die Vorlage (Auslöser und Nachlauf werden aus den Workflows des
# Repos abgeleitet).
#
# DIE REGEL (PO 2026-10-11, alle Repos): Was die Pflicht-Checks abnehmen, mergt selbst — auch Majors.
# Eine Meldung gibt es nur, wenn etwas bricht oder nichts abnimmt: Dann steht ein Kommentar am PR,
# und der liegende PR erreicht den PO über ci-wache („liegt“). Die Wartezeit von drei Tagen
# (`cooldown` in dependabot.yml) bleibt, damit ein frisch kompromittiertes Release nicht durchläuft.
# Von Hand bleiben:
#   - fremde Commits im PR (nicht von Dependabot),
#   - ein Ökosystem, das kein Pflicht-Check abnimmt (`AUTO_OEKO`),
#   - eine Action, die in keinem Pflicht-Workflow AUF DEM PR läuft (nur am Tag, nur auf main),
#   - ein roter Pflicht-Workflow.
#
# WARUM `workflow_run` und nicht `gh pr merge --auto`: Ein Merge mit dem Workflow-Token startet
# KEINE Workflows („events triggered by the GITHUB_TOKEN … will not create a new workflow run“,
# GitHub-Doku); mit `--auto` lief auf main danach weder CI noch Pages. Ausgenommen ist
# `workflow_dispatch`: Deshalb mergt dieser Workflow selbst und stößt danach die Workflows an, die
# ein Push auf den Standardzweig starten würde (Nachlauf).
#
# Ausgelöst vom Ende JEDES Pflicht-Workflows. Gemergt wird erst, wenn für genau diesen Kopf jeder
# Pflicht-Workflow gelaufen und grün ist — das gilt auch in privaten Repos ohne Branch-Protection.
# Wer zuletzt fertig wird, mergt; die anderen enden mit „wartet auf …“. Je Kopf läuft nur eine
# Instanz (`concurrency`).
#
# Zwei Jobs: `entscheiden` liest nur (API, kein Checkout, kein PR-Code), `ausfuehren` hält die
# Schreibrechte und ruft nur `gh pr merge`, `gh workflow run` und `gh pr comment`.
name: Dependabot Auto-Merge

on:  # zizmor: ignore[dangerous-triggers] — kein Checkout, kein PR-Code; Herkunft per API geprüft
  workflow_run:
    workflows: @@WORKFLOWS@@
    types: [completed]

permissions: {}

concurrency:
  group: dependabot-auto-merge-${{ github.event.workflow_run.head_sha }}
  cancel-in-progress: false

jobs:
  entscheiden:
    # Nur Läufe aus einem PR im EIGENEN Repo auf einem Dependabot-Zweig. Branchname und
    # Commit-Nachricht kann ein Fork-PR fälschen — deshalb unten alles noch einmal per API.
    if: >
      github.event.workflow_run.event == 'pull_request' &&
      github.event.workflow_run.head_repository.full_name == github.repository &&
      startsWith(github.event.workflow_run.head_branch, 'dependabot/')
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read
      checks: read
      actions: read
    outputs:
      aktion: ${{ steps.pruefung.outputs.aktion }}
      grund: ${{ steps.pruefung.outputs.grund }}
      pr: ${{ steps.pruefung.outputs.pr }}
    steps:
      - name: Herkunft, Abnahme und Pflicht-Workflows prüfen
        id: pruefung
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPO: ${{ github.repository }}
          HEAD_SHA: ${{ github.event.workflow_run.head_sha }}
          # --- je Repo: Anfang
@@JE_REPO@@
          # --- je Repo: Ende
        run: |
          set -euo pipefail
          ausgabe() {
            { echo "aktion=$1"; echo "grund=$2"; echo "pr=${PR:-}"; } >> "$GITHUB_OUTPUT"
            echo "$1${2:+: $2}"
          }
          PR="$(gh api "repos/$REPO/commits/$HEAD_SHA/pulls" -q '.[0].number // ""')"
          [[ "$PR" =~ ^[0-9]+$ ]] || { ausgabe nichts "kein PR zu $HEAD_SHA"; exit 0; }
          # Herkunft per API, nie dem Ereignis glauben: Autor Dependabot, kein Fork, offen, Kopf unverändert.
          J="$(gh api "repos/$REPO/pulls/$PR")"
          [ "$(jq -r '.user.login' <<<"$J")" = "dependabot[bot]" ] || { ausgabe nichts "Autor ist nicht Dependabot"; exit 0; }
          [ "$(jq -r '.head.repo.full_name == .base.repo.full_name' <<<"$J")" = "true" ] || { echo "Fork — Abbruch"; exit 1; }
          [ "$(jq -r '.state' <<<"$J")" = "open" ] || { ausgabe nichts "PR nicht offen"; exit 0; }
          [ "$(jq -r '.head.sha' <<<"$J")" = "$HEAD_SHA" ] || { ausgabe nichts "Kopf seit dem Lauf bewegt"; exit 0; }
          # Ein Kommentar je Grund genügt — der Workflow läuft je PR mehrmals.
          schon_gesagt() {
            [ "$(gh api "repos/$REPO/issues/$PR/comments" --paginate | jq -s --arg g "$1" \
              '[.[][] | select(.user.login == "github-actions[bot]" and (.body | contains($g)))] | length')" != "0" ]
          }
          kommentar() {
            if schon_gesagt "$1"; then ausgabe nichts "$1 (schon kommentiert)"; else ausgabe kommentieren "$1"; fi
          }
          # Ökosystem aus dem Branch (dependabot/<ökosystem>/…). Der Update-Typ entscheidet nichts
          # (auch Majors mergen, PO 2026-10-11); er steht nur im Protokoll.
          ZWEIG="$(jq -r '.head.ref' <<<"$J")"
          OEKO="${ZWEIG#dependabot/}"; OEKO="${OEKO%%/*}"
          COMMITS="$(gh api "repos/$REPO/pulls/$PR/commits" --paginate)"
          NACHRICHTEN="$(jq -r '.[].commit.message' <<<"$COMMITS")"
          TYPEN="$(grep -oE 'update-type: version-update:semver-(major|minor|patch)' <<<"$NACHRICHTEN" | sort -u || true)"
          echo "Ökosystem: $OEKO, Update-Typ: ${TYPEN:-nicht erkennbar}"
          GRUND=""
          [ "$(jq -r '[.[] | select(.author.login != "dependabot[bot]")] | length' <<<"$COMMITS")" = "0" ] \
            || GRUND="Commits, die nicht von Dependabot stammen"
          case " $AUTO_OEKO " in *" $OEKO "*) ;; *) GRUND="${GRUND:-kein Pflicht-Check nimmt \"$OEKO\" ab}" ;; esac
          # Actions nur, wenn JEDE aktualisierte Action in einem Pflicht-Workflow AUF DEM PR läuft:
          # Jobs und Schritte, die am Tag hängen, zählen nicht — ihr Bump bräche erst beim Release.
          # Die Generalprobe (Schritt mit `ref_type != 'tag'` gegen ein Wegwerf-Ziel) zählt.
          if [ -z "$GRUND" ] && [ "$OEKO" = "github_actions" ]; then
            AM_TAG="ref_type *== *.tag.|startsWith\\(github\\.ref, *.refs/tags"
            LAUFEN=""
            for wf in $PFLICHT_WORKFLOWS; do
              TEXT="$(gh api "repos/$REPO/contents/.github/workflows/$wf?ref=$HEAD_SHA" -q .content | base64 -d)"
              LAUFEN+="$(AM_TAG="$AM_TAG" yq -r '.jobs[]
                | select(((.if // "") | test(strenv(AM_TAG))) | not)
                | .steps[]?
                | select(((.if // "") | test(strenv(AM_TAG))) | not)
                | .uses // ""' <<<"$TEXT" | sed 's/@.*//')"$'\n'
            done
            NAMEN="$(sed -n 's/^[- ]*dependency-name: *//p' <<<"$NACHRICHTEN" | sort -u)"
            [ -n "$NAMEN" ] || GRUND="aktualisierte Actions nicht erkennbar"
            while IFS= read -r n; do
              [ -z "$n" ] && continue
              grep -qxE "${n//./\\.}(/.*)?" <<<"$LAUFEN" \
                || { GRUND="Action \"$n\" läuft in keinem Pflicht-Workflow auf dem PR"; break; }
            done <<<"$NAMEN"
          fi
          if [ -n "$GRUND" ]; then kommentar "$GRUND"; exit 0; fi
          # Jeder Pflicht-Workflow muss für genau diesen Kopf gelaufen und grün sein. Läuft einer
          # noch, endet dieser Lauf; dessen Ende löst den nächsten Anlauf aus.
          LAEUFE="$(gh api "repos/$REPO/actions/runs?head_sha=$HEAD_SHA&event=pull_request&per_page=100" -q '.workflow_runs')"
          for wf in $PFLICHT_WORKFLOWS; do
            L="$(jq -c --arg p ".github/workflows/$wf" '[.[] | select(.path == $p)] | sort_by(.created_at) | last // empty' <<<"$LAEUFE")"
            [ -n "$L" ] || { ausgabe nichts "wartet auf $wf (noch kein Lauf)"; exit 0; }
            [ "$(jq -r '.status' <<<"$L")" = "completed" ] || { ausgabe nichts "wartet auf $wf"; exit 0; }
            ERG="$(jq -r '.conclusion' <<<"$L")"
            [ "$ERG" = "success" ] || { kommentar "Pflicht-Workflow $wf ist rot ($ERG)"; exit 0; }
          done
          # Alle grün. Jetzt noch die Checks, die NACH ihrem Workflow kommen (CodeQL-Ergebnis):
          # warten, bis GitHub den PR als mergebar meldet und kein Check mehr läuft — mit Frist.
          for _ in $(seq 1 30); do
            P="$(gh pr view "$PR" --repo "$REPO" --json state,headRefOid,mergeStateStatus,statusCheckRollup)"
            [ "$(jq -r '.state' <<<"$P")" = "OPEN" ] || { ausgabe nichts "PR nicht mehr offen"; exit 0; }
            [ "$(jq -r '.headRefOid' <<<"$P")" = "$HEAD_SHA" ] || { ausgabe nichts "Kopf bewegt"; exit 0; }
            ROT="$(jq -r '[.statusCheckRollup[] | select(((.conclusion // .state // "") | test("FAILURE|ERROR|CANCELLED|TIMED_OUT|ACTION_REQUIRED|STARTUP_FAILURE")) ) | (.name // .context)] | unique | join(", ")' <<<"$P")"
            [ -z "$ROT" ] || { kommentar "Check rot ($ROT)"; exit 0; }
            OFFEN="$(jq -r '[.statusCheckRollup[] | select((.status // "COMPLETED") != "COMPLETED" or (.state // "") == "PENDING")] | length' <<<"$P")"
            case "$(jq -r '.mergeStateStatus' <<<"$P")" in
              CLEAN) [ "$OFFEN" = "0" ] && { ausgabe mergen ""; exit 0; } ;;
              BEHIND|DIRTY) ausgabe nichts "Zweig veraltet oder im Konflikt — Dependabot zieht nach"; exit 0 ;;
            esac
            sleep 20
          done
          ausgabe nichts "nach 10 min noch nicht mergebar — der nächste fertige Pflicht-Workflow prüft erneut"

  ausfuehren:
    timeout-minutes: 10
    needs: entscheiden
    if: needs.entscheiden.outputs.aktion == 'mergen' || needs.entscheiden.outputs.aktion == 'kommentieren'
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
      actions: write       # `gh workflow run` für den Nachlauf
    steps:
      # Gemergt wird genau der geprüfte Kopf. Danach der Nachlauf: Was ein Push auf den
      # Standardzweig startet, stößt hier `workflow_dispatch` an.
      - name: Mergen und den Nachlauf anstoßen
        if: needs.entscheiden.outputs.aktion == 'mergen'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPO: ${{ github.repository }}
          PR: ${{ needs.entscheiden.outputs.pr }}
          HEAD_SHA: ${{ github.event.workflow_run.head_sha }}
          STANDARD: ${{ github.event.repository.default_branch }}
        run: |
          gh pr merge "$PR" --repo "$REPO" --squash --delete-branch --match-head-commit "$HEAD_SHA"
@@NACHLAUF@@
      - name: Begründen, warum von Hand
        if: needs.entscheiden.outputs.aktion == 'kommentieren'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPO: ${{ github.repository }}
          PR: ${{ needs.entscheiden.outputs.pr }}
          GRUND: ${{ needs.entscheiden.outputs.grund }}
        run: |
          gh pr comment "$PR" --repo "$REPO" --body "⚠️ Nicht automatisch gemergt: $GRUND. Bitte von Hand prüfen und mergen."
