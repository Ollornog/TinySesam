{
  "name": "@tinysesam/gate",
  "version": "0.1.0",
  "description": "Gate client for applications behind TinySesam: header mode and gate token checks (Ed25519, WebCrypto).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ollornog/TinySesam.git",
    "directory": "clients/js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome ci .",
    "test": "node --test --test-reporter=dot \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "fast-check": "4.11.0",
    "typescript": "7.0.2"
  }
}
