<?xml version="1.0"?>
<!-- Code style of the PHP gate client: PSR-12 plus strict types everywhere. PHP_CodeSniffer rather than PHP CS Fixer:
     the fixer refuses to run on a PHP newer than it knows (8.6 at the time of writing), and the gate runs on the newest. -->
<ruleset name="tinysesam-gate">
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <!-- Lines up to 120 characters, as in the rest of the repository; longer ones fail. -->
    </rule>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
    </rule>
    <rule ref="Generic.PHP.RequireStrictTypes"/>
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Squiz.Strings.DoubleQuoteUsage.NotRequired"/>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInImplementedInterfaceAfterLastUsed">
        <severity>0</severity>
    </rule>
</ruleset>
