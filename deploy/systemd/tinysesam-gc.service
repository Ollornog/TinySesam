[Unit]
Description=TinySesam aufräumen (abgelaufene Sitzungen, Flows, Einmal-Token)
# Ohne Umlaut: systemd verwirft eine Documentation=-Zeile mit Nicht-ASCII still, `systemctl show`
# zeigt dann gar keine. Der Anker ist der der englischen README — die liefert github.com aus.
Documentation=https://github.com/Ollornog/TinySesam#backups-and-cleanup

[Service]
Type=oneshot
# Anpassen: Benutzer des Dienstes und Pfad der Datenbank.
User=tinysesam
ExecStart=/opt/tinysesam/venv/bin/python -m tinysesam gc --db /var/lib/tinysesam/auth.db

# Das Aufräumen braucht nichts ausser seiner Datenbank.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tinysesam
