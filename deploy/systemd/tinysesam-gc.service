[Unit]
Description=TinySesam aufräumen (abgelaufene Sitzungen, Flows, Einmal-Token)
# Without an umlaut: systemd silently discards a Documentation= line with non-ASCII, `systemctl show`
# then shows none at all. The anchor is that of the English README — which github.com serves.
Documentation=https://github.com/Ollornog/TinySesam#backups-and-cleanup

[Service]
Type=oneshot
# Adjust: the service's user and the database path.
User=tinysesam
ExecStart=/opt/tinysesam/venv/bin/python -m tinysesam gc --db /var/lib/tinysesam/auth.db

# The cleanup needs nothing except its database.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tinysesam
