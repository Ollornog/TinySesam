# TinySesam as a gate in front of a third-party application — with gate token (ADR-9).
#
# The difference to ./Caddyfile: there Caddy asks /auth/forward for EVERY request, even for every
# script, stylesheet and icon. Here Caddy checks a short-lived, signed cookie itself and
# asks TinySesam only when it is missing or expired:
#
#   request ──► jwtauth: gate cookie valid? ──yes──► application        (no call to TinySesam)
#                         │ no (401)
#                         ▼
#               handle_errors 401: /auth/forward as before
#                         ├─ 200 → application, plus Set-Cookie with a new gate token
#                         ├─ 401 → login (X-TinySesam-Location)
#                         └─ 403 → role missing
#
# The fallback path is the existing forward-auth, word for word. It passes the request along with its method
# and body to the application — so a POST with an expired token is not lost.
#
# Prerequisites:
#   * Caddy WITH the plugin caddy-jwt (github.com/ggicci/caddy-jwt). The official image does not have
#     it — build instructions: deploy/forward-auth/caddy-gate/Dockerfile.
#   * TinySesamConfig: forward_auth_enabled=True, gate_token_enabled=True, base_url, cookie_domain
#     and trusted_redirect_hosts as in ./Caddyfile (central sign-in on auth.example.com).
#     In the gateway image: TINYSESAM_GATE=1.
#   * TS_GATE_PUBKEY: the public key, `tinysesam gate-key` prints it. It follows the
#     installation's base key (TINYSESAM_SECRETS_KEY) — if that is changed, enter it
#     here again. Public, not a secret.
#   * TS_GATE_ISSUER: base_url of TinySesam, without a trailing slash.
#
# What it costs: a revocation (sign-out, lockout, withdrawn approval) takes effect here only when the
# token expires — gate_token_ttl_sec, default 300 seconds.

# Central auth service (TinySesam) — its own subdomain
auth.example.com {
	reverse_proxy {$TS_AUTH_UPSTREAM:127.0.0.1:8000}
}

# Protected application
app.example.com {
	# ONLY this proxy sets the identity. A Remote-User sent along by the browser would
	# otherwise be passed through on every path where nobody overwrites it.
	request_header -Remote-User
	request_header -Remote-Name
	request_header -Remote-Email
	request_header -Remote-Groups
	request_header -Remote-Id

	# Sign-out at the application (T-22): /.tinysesam/logout and /.tinysesam/after-logout belong to
	# TinySesam, not to the application — and bypass the gate: signing out must also work with an
	# expired sign-in. On this host, because only here can the gate cookie be deleted.
	# The application's sign-out link points to https://app.example.com/.tinysesam/logout
	# (?scope=app|all, otherwise forward_logout applies); register
	# https://app.example.com/.tinysesam/after-logout with the provider as Logout Callback URL.
	handle /.tinysesam/* {
		reverse_proxy {$TS_AUTH_UPSTREAM:127.0.0.1:8000}
	}

	# Public paths of the application (T-20), such as share links: without sign-in, without identity.
	# TS_SHARE_PRAEFIX is a regular expression over the beginning of the path, e.g.
	#   TS_SHARE_PRAEFIX='^/(s|public/share)/'
	# Without the variable `^$` applies — it matches no path, the exception is off.
	#
	# The RAW path (`orig_uri.path`) is checked, not the one cleaned up by Caddy: otherwise Caddy
	# compares `/x/../s/a` as `/s/a`, but passes `/x/../s/a` on to the application — which may
	# resolve it differently. Therefore every path with a `.` or `..` segment, also one with a
	# path parameter (`..;x`, `.;`; Tomcat/Spring read `/s/..;/admin` as `/admin`), backslash, NUL or
	# an encoded form of these (%2e %2f %5c %00; `%3b` only right behind a dot segment) is rejected.
	# Caddy matches the DECODED path: a plain `;` or `%3B` elsewhere is an ordinary file-name character
	# (`/s/<token>/file_%3B%29.bin`) and passes — rejecting every `;` sent such downloads to the login
	# (B-3). Case counts (`/S/` is not `/s/`). Measured against Caddy 2.11.7 in
	# tests/test_gate_caddy.py. Never allow by file extension (`*.js`): many
	# applications serve dynamic content under `/admin/x.css`.
	#
	# A share page usually loads its own scripts and calls its own APIs — these belong in
	# the expression too, measured per application. Whatever is listed here is publicly reachable: a vulnerability
	# of the application in these paths stays open. As narrow as possible.
	@share {
		vars_regexp share {http.request.orig_uri.path} {$TS_SHARE_PRAEFIX:^$}
		not vars_regexp {http.request.orig_uri.path} (?i)(^|/)\.\.?(/|;|%3b|$)|[\\\x00]|%(2e|2f|5c|00)
	}
	handle @share {
		reverse_proxy {$TS_APP_UPSTREAM:127.0.0.1:9000} {
			# No identity on this path — not even one the browser sends along itself.
			header_up -Remote-User
			header_up -Remote-Name
			header_up -Remote-Email
			header_up -Remote-Groups
			header_up -Remote-Id
			header_up Cookie "(^|;)\s*(__Host-|__Secure-)?tinysesam_[^=;]*=[^;]*" ""
			header_up Cookie "^[;\s]+" ""
		}
	}

	route {
		jwtauth {
			sign_key {$TS_GATE_PUBKEY}
			# Fixed to EdDSA: with sign_alg EdDSA caddy-jwt ignores the `alg` in the token's header.
			# A token with `alg: none` or `HS256` is thus not checked any differently.
			sign_alg EdDSA
			from_cookies __Host-tinysesam_gate
			issuer_whitelist {$TS_GATE_ISSUER:https://auth.example.com}
			# The audience is the host. If the fallback path requires roles (X-TinySesam-Roles below),
			# the token carries them: `app.example.com|roles=admin,redaktion` — roles sorted,
			# several entries separated by `;`. Exactly this string then belongs here, otherwise
			# every request falls back to the fallback path (safe, just slow).
			audience_whitelist app.example.com
			user_claims sub
			meta_claims ts_user ts_name ts_email ts_groups ts_id
		}
		reverse_proxy {$TS_APP_UPSTREAM:127.0.0.1:9000} {
			header_up Remote-User {http.auth.user.ts_user}
			header_up Remote-Name {http.auth.user.ts_name}
			header_up Remote-Email {http.auth.user.ts_email}
			header_up Remote-Groups {http.auth.user.ts_groups}
			header_up Remote-Id {http.auth.user.ts_id}
			# TinySesam's cookies do not reach the application — the gate cookie is also named
			# tinysesam_* and falls under the same rule (B-20, see ./Caddyfile).
			header_up Cookie "(^|;)\s*(__Host-|__Secure-)?tinysesam_[^=;]*=[^;]*" ""
			header_up Cookie "^[;\s]+" ""
		}
	}

	# No gate token or no valid one: the fallback path via /auth/forward.
	# A 401 from the application itself does NOT land here — reverse_proxy passes it through as a
	# response, handle_errors sees only errors from Caddy (here: the rejection by jwtauth).
	handle_errors 401 {
		route {
			reverse_proxy {$TS_AUTH_UPSTREAM:127.0.0.1:8000} {
				method GET
				rewrite /auth/forward
				header_up X-Forwarded-Method {method}
				header_up X-Forwarded-Uri {uri}
				# header_up X-TinySesam-Roles redaktion,admin   # then adjust audience_whitelist above
				@ok status 200
				handle_response @ok {
					request_header Remote-User {rp.header.Remote-User}
					request_header Remote-Name {rp.header.Remote-Name}
					request_header Remote-Email {rp.header.Remote-Email}
					request_header Remote-Groups {rp.header.Remote-Groups}
					request_header Remote-Id {rp.header.Remote-Id}
					# The new gate token goes to the browser with the application's response.
					# Placeholder in Go-canonical form (H-16, see ./Caddyfile).
					header +Set-Cookie {rp.header.X-Tinysesam-Gate-Cookie}
				}
				@denied status 401
				handle_response @denied {
					redir {rp.header.X-Tinysesam-Location} 302
				}
				@norole status 403
				handle_response @norole {
					respond "Kein Zugriff: fehlende Rolle." 403
				}
			}
			reverse_proxy {$TS_APP_UPSTREAM:127.0.0.1:9000} {
				header_up Cookie "(^|;)\s*(__Host-|__Secure-)?tinysesam_[^=;]*=[^;]*" ""
				header_up Cookie "^[;\s]+" ""
			}
		}
	}
}
