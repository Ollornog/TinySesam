# TinySesam as a gate in front of a third-party application — with gate token (ADR-9).
#
# The difference to ./Caddyfile: there Caddy asks /auth/forward for EVERY request, even for every
# script, stylesheet and icon. Here Caddy checks a short-lived, signed cookie itself and
# asks TinySesam only when it is missing or expired:
#
#   request ──► jwtauth: gate cookie valid? ──yes──► application        (no call to TinySesam)
#                         │ no (401)
#                         ▼
#               handle_errors 401: /auth/forward as before
#                         ├─ 200 → application, plus Set-Cookie with a new gate token
#                         ├─ 401 → login (X-TinySesam-Location)
#                         └─ 403 → role missing
#
# The fallback path is the existing forward-auth, word for word. It passes the request along with its method
# and body to the application — so a POST with an expired token is not lost.
#
# Prerequisites:
#   * Caddy WITH the plugin caddy-jwt (github.com/ggicci/caddy-jwt). The official image does not have
#     it — build instructions: deploy/forward-auth/caddy-gate/Dockerfile.
#   * TinySesamConfig: forward_auth_enabled=True, gate_token_enabled=True, base_url, cookie_domain
#     and trusted_redirect_hosts as in ./Caddyfile (central sign-in on auth.example.com).
#     In the gateway image: TINYSESAM_GATE=1.
#   * TS_GATE_PUBKEY: the public gate key, the output of `tinysesam gate-key --db …` (in the gateway container:
#     `python -m tinysesam gate-key --db /data/gateway.db`). After `tinysesam keys rotate --purpose gate` give Caddy
#     the new value; until then the tokens of the new key take the way back (slower, nobody is signed out).
#     NOT `jwk_url` (/auth/gate/jwks.json), although TinySesam publishes the set: with caddy-jwt 1.4.0 a single
#     failed first fetch (TinySesam not up yet when the first token arrives, a 404) makes every later request with a
#     gate token hang — the plugin waits for the key set without a deadline while holding a lock (`Cache.Register`,
#     jwx/httprc `WaitReady`), retries only after its long interval and never falls back. A fixed key cannot hang.
#   * TS_GATE_ISSUER: base_url of TinySesam, without a trailing slash.
#
# What it costs: a revocation (sign-out, lockout, withdrawn approval) takes effect here only when the
# token expires — gate_token_ttl_sec, default 300 seconds.

# Central auth service (TinySesam) — its own subdomain
auth.example.com {
	# HSTS (ASVS 3.4.1): one year, also for subdomains OF THIS HOST — never for its siblings or the parent
	# domain. No `preload`: the browsers' preload list is hard to leave again. Caddy does not set it itself.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy {$TS_AUTH_UPSTREAM:127.0.0.1:8000}
}

# Protected application
app.example.com {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"   # HSTS, see above

	# ONLY this proxy sets the identity. A Remote-User sent along by the browser would
	# otherwise be passed through on every path where nobody overwrites it.
	request_header -Remote-User
	request_header -Remote-Name
	request_header -Remote-Email
	request_header -Remote-Groups
	request_header -Remote-Id
	request_header -Remote-Auth
	request_header -Remote-Kind
	# Nor a target the browser made up (F1): an X-Original-URL/-URI of its own reached the application, which
	# builds addresses or decides from it (measured in tests/test_gate_caddy.py).
	request_header -X-Original-URL
	request_header -X-Original-URI

	# Sign-out at the application (T-22): /.tinysesam/logout and /.tinysesam/after-logout belong to
	# TinySesam, not to the application — and bypass the gate: signing out must also work with an
	# expired sign-in. On this host, because only here can the gate cookie be deleted.
	# The application's sign-out link points to https://app.example.com/.tinysesam/logout
	# (?scope=app|all, otherwise forward_logout applies); register
	# https://app.example.com/.tinysesam/after-logout with the provider as Logout Callback URL.
	handle /.tinysesam/* {
		reverse_proxy {$TS_AUTH_UPSTREAM:127.0.0.1:8000}
	}

	# OAuth for MCP clients (T-36, optional) — see ./Caddyfile. A request with an access token carries no gate
	# cookie, so it always takes the fallback path below, where TinySesam checks the token per request.
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy {$TS_AUTH_UPSTREAM:127.0.0.1:8000}
	}

	# Public paths of the application (T-20), such as share links: without sign-in, without identity.
	# TS_SHARE_PREFIX is a regular expression over the beginning of the path, e.g.
	#   TS_SHARE_PREFIX='^/(s|public/share)/'
	# Without the variable `^$` applies — it matches no path, the exception is off.
	#
	# The RAW path (`orig_uri.path`) is checked, not the one cleaned up by Caddy: otherwise Caddy
	# compares `/x/../s/a` as `/s/a`, but passes `/x/../s/a` on to the application — which may
	# resolve it differently. Therefore every path with a `.` or `..` segment, also one with a
	# path parameter (`..;x`, `.;`; Tomcat/Spring read `/s/..;/admin` as `/admin`), backslash, NUL or
	# an encoded form of these (%2e %2f %5c %00; `%3b` only right behind a dot segment) is rejected.
	# Caddy matches the DECODED path: a plain `;` or `%3B` elsewhere is an ordinary file-name character
	# (`/s/<token>/file_%3B%29.bin`) and passes — rejecting every `;` sent such downloads to the login
	# (B-3). Case counts (`/S/` is not `/s/`). Measured against Caddy 2.11.7 in
	# tests/test_gate_caddy.py. Never allow by file extension (`*.js`): many
	# applications serve dynamic content under `/admin/x.css`.
	#
	# A share page usually loads its own scripts and calls its own APIs — these belong in
	# the expression too, measured per application. Whatever is listed here is publicly reachable: a vulnerability
	# of the application in these paths stays open. As narrow as possible.
	@share {
		vars_regexp share {http.request.orig_uri.path} {$TS_SHARE_PREFIX:^$}
		not vars_regexp {http.request.orig_uri.path} (?i)(^|/)\.\.?(/|;|%3b|$)|[\\\x00]|%(2e|2f|5c|00)
	}
	handle @share {
		reverse_proxy {$TS_APP_UPSTREAM:127.0.0.1:9000} {
			# The client's credentials end here (attack round 2026-11-21, A-3): TinySesam has decided, the application
			# trusts Remote-*. An app password, an OAuth access token or an API key (`tsk_…`, valid at every host and at
			# TinySesam's own API) must not reach a debug page, an error report or a header log of the application.
			# Your application checks Authorization ITSELF (its own Basic auth behind the gate)? Then delete these two
			# lines for that host — deliberately, and only there (SECURITY.md, "Credentials at the application").
			header_up -Authorization
			header_up -X-Api-Key
			# No identity on this path — not even one the browser sends along itself.
			header_up -Remote-User
			header_up -Remote-Name
			header_up -Remote-Email
			header_up -Remote-Groups
			header_up -Remote-Id
			header_up -Remote-Auth
			header_up -Remote-Kind
			header_up Cookie "(^|;)\s*(__Host-|__Secure-)?tinysesam_[^=;]*=[^;]*" ""
			header_up Cookie "^[;\s]+" ""
		}
	}

	route {
		# jwtauth only ever sees the gate cookie. caddy-jwt (v1.4.0) also takes `Authorization` as a token candidate,
		# whatever `from_cookies` says, and logs a candidate that is no JWT with a third of its beginning and end — an
		# API key, an OAuth token or an app password of every API and MCP call would land in the proxy log. A request
		# that carries Authorization, or no gate cookie at all, goes straight to the way back below (handle_errors 401,
		# /auth/forward), where TinySesam checks it. Renamed the gate cookie (gate_cookie_name)? Rename it here too.
		@no_gate_cookie not header_regexp Cookie (^|;\s*)__Host-tinysesam_gate=
		@has_authorization header Authorization *
		error @no_gate_cookie 401
		error @has_authorization 401
		jwtauth {
			# The public gate key (no secret), checked locally — no fetch that could hang (see the header).
			# `caddy reload` resolves {$…} in the CALLING process: under systemd put TS_GATE_PUBKEY in EnvironmentFile=
			# (unit level, applies to ExecReload= too), else the reload fails and the old configuration stays (README).
			sign_key {$TS_GATE_PUBKEY}
			# Fixed to EdDSA: with sign_alg EdDSA caddy-jwt ignores the `alg` in the token's header.
			# A token with `alg: none` or `HS256` is thus not checked any differently.
			sign_alg EdDSA
			from_cookies __Host-tinysesam_gate
			issuer_whitelist {$TS_GATE_ISSUER:https://auth.example.com}
			# The audience is the host. If the fallback path requires roles (X-TinySesam-Roles below),
			# the token carries them: `app.example.com|roles=admin,editors` — roles sorted,
			# several entries separated by `;`. Exactly this string then belongs here, otherwise
			# every request falls back to the fallback path (safe, just slow).
			audience_whitelist app.example.com
			user_claims sub
			meta_claims ts_user ts_name ts_email ts_groups ts_id ts_auth ts_kind
		}
		reverse_proxy {$TS_APP_UPSTREAM:127.0.0.1:9000} {
			# The client's credentials end here (A-3, see the first application upstream above).
			header_up -Authorization
			header_up -X-Api-Key
			header_up Remote-User {http.auth.user.ts_user}
			header_up Remote-Name {http.auth.user.ts_name}
			header_up Remote-Email {http.auth.user.ts_email}
			header_up Remote-Groups {http.auth.user.ts_groups}
			header_up Remote-Id {http.auth.user.ts_id}
			# `session` (T-75): a gate token is issued only for a session and carries the kind as a signed claim —
			# the same value the way back through /auth/forward sets.
			header_up Remote-Auth {http.auth.user.ts_auth}
			# `user` or `service` (spec v2): every gate token carries ts_kind. A token issued before the update has
			# none — caddy-jwt then sends Remote-Kind with an EMPTY value, never placeholder text (measured in
			# tests/test_gate_caddy.py), and a gate client after spec v2 refuses the request until the token expires.
			header_up Remote-Kind {http.auth.user.ts_kind}
			# TinySesam's cookies do not reach the application — the gate cookie is also named
			# tinysesam_* and falls under the same rule (B-20, see ./Caddyfile).
			header_up Cookie "(^|;)\s*(__Host-|__Secure-)?tinysesam_[^=;]*=[^;]*" ""
			header_up Cookie "^[;\s]+" ""
		}
	}

	# No gate token or no valid one: the fallback path via /auth/forward.
	# A 401 from the application itself does NOT land here — reverse_proxy passes it through as a
	# response, handle_errors sees only errors from Caddy (here: the rejection by jwtauth).
	handle_errors 401 {
		route {
			reverse_proxy {$TS_AUTH_UPSTREAM:127.0.0.1:8000} {
				method GET
				rewrite /auth/forward
				header_up X-Forwarded-Method {method}
				header_up X-Forwarded-Uri {uri}
				# Only the proxy names the target (F1): no X-Original-URL/-URI from the browser.
				header_up -X-Original-URL
				header_up -X-Original-URI
				# header_up X-TinySesam-Roles editors,admin   # then adjust audience_whitelist above
				@ok status 200
				handle_response @ok {
					# Each header only when the answer carries it (T-58, see ./Caddyfile).
					@ts_user not vars {rp.header.Remote-User} ""
					@ts_name not vars {rp.header.Remote-Name} ""
					@ts_email not vars {rp.header.Remote-Email} ""
					@ts_groups not vars {rp.header.Remote-Groups} ""
					@ts_id not vars {rp.header.Remote-Id} ""
					@ts_auth not vars {rp.header.Remote-Auth} ""
					@ts_kind not vars {rp.header.Remote-Kind} ""
					request_header @ts_user Remote-User {rp.header.Remote-User}
					request_header @ts_name Remote-Name {rp.header.Remote-Name}
					request_header @ts_email Remote-Email {rp.header.Remote-Email}
					request_header @ts_groups Remote-Groups {rp.header.Remote-Groups}
					request_header @ts_id Remote-Id {rp.header.Remote-Id}
					request_header @ts_auth Remote-Auth {rp.header.Remote-Auth}
					request_header @ts_kind Remote-Kind {rp.header.Remote-Kind}
					# The new gate token goes to the browser with the application's response.
					# Placeholder in Go-canonical form (H-16, see ./Caddyfile).
					header +Set-Cookie {rp.header.X-Tinysesam-Gate-Cookie}
				}
				# OAuth resource (T-36): pass the 401 with its Bearer challenge through — before @denied.
				@oauth {
					status 401
					header X-Tinysesam-Reason oauth
				}
				handle_response @oauth {
					header WWW-Authenticate {rp.header.Www-Authenticate}
					respond 401
				}
				# App passwords (T-66): a client without a browser (WebDAV, CalDAV/CardDAV, Git) gets TinySesam's 401 with
				# `WWW-Authenticate: Basic`, not a login page — only at a host with forward_apps[host]["app_passwords"]; TinySesam
				# sends this reason nowhere else. The application's reverse_proxy below drops Authorization (A-3): it
				# trusts Remote-User and does not need the app password.
				@basic {
					status 401
					header X-Tinysesam-Reason basic
				}
				handle_response @basic {
					header WWW-Authenticate {rp.header.Www-Authenticate}
					respond 401
				}
				@denied status 401
				handle_response @denied {
					redir {rp.header.X-Tinysesam-Location} 302
				}
				@norole status 403
				handle_response @norole {
					respond "Access denied: missing role." 403
				}
			}
			reverse_proxy {$TS_APP_UPSTREAM:127.0.0.1:9000} {
				# The client's credentials end here (A-3, see the first application upstream above).
				header_up -Authorization
				header_up -X-Api-Key
				header_up Cookie "(^|;)\s*(__Host-|__Secure-)?tinysesam_[^=;]*=[^;]*" ""
				header_up Cookie "^[;\s]+" ""
			}
		}
	}
}
