#!/usr/bin/env bash
# Letzte Bremse vor dem Push. Aktivieren: git config core.hooksPath .githooks
# Notausgang (nur mit gutem Grund): git push --no-verify
#
# Standardfall: `scripts/check.sh` läuft nativ. Wer die Suite lieber in einem Container
# fährt (gleiche Toolchain wie die CI, unabhängig vom Rechner), legt sich ein `ci-local`
# in den PATH — dann benutzt der Hook es von selbst.
#
# Ist `ci-local` vorhanden, aber Docker nicht ansprechbar, wird der Push auf
# Feature-Branches ABGEBROCHEN: Wer den Container-Lauf eingerichtet hat, verlässt sich
# darauf, und auf Feature-Branches läuft keine CI (on.push.branches: [main]). Ein stiller
# Rückfall auf den Host würde genau dieses Netz entfernen. Beim Push auf `main` genügt der
# native Lauf, weil dort anschließend die CI als Gate greift.
#
# Der native Pfad prüft anschließend selbst, ob die Suite Rückstände hinterlassen hat
# (das macht sonst `ci-local`, nicht `check.sh`). Ein Test, der schreibt, ist beim
# zweiten Lauf nicht mehr wiederholbar.
#
# Kein Schleifenrisiko: ci-local setzt CI_LOCAL_INSIDE=1 im Container und ruft dort
# check.sh direkt auf, nicht diesen Hook.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# ---------------------------------------------------------------------------
# Nativer Lauf + Rückstands-Check.
#
# `exec check.sh` wäre kürzer, ersetzt aber den Prozess — danach lässt sich nichts
# mehr prüfen. Verglichen wird gegen den Zustand VOR dem Lauf, damit ein bereits
# schmutziger Arbeitsbaum nicht fälschlich als Rückstand gilt.
#
# Die Prüfung selbst steht in `scripts/_residue_check.sh` — derselben Datei, die auch
# die GitHub-CI fährt. Sie stand einmal fünffach im Umlauf, und die CI-Fassungen
# ignorierten `.ci-allow-dirty`; das verbindliche Gate widersprach dem lokalen Netz.
# ---------------------------------------------------------------------------
run_native_with_residue_check() {
    local vorher rc=0

    if [[ ! -x "$ROOT/scripts/_residue_check.sh" ]]; then
        echo "pre-push: ABGEBROCHEN — scripts/_residue_check.sh fehlt." >&2
        echo "Ohne den Rückstands-Check ist der native Lauf kein Netz." >&2
        echo "Auf dem Tower: repokit sync" >&2
        return 1
    fi

    vorher="$(mktemp)"
    # shellcheck disable=SC2064
    trap "rm -f '$vorher'" RETURN

    "$ROOT/scripts/_residue_check.sh" snapshot > "$vorher"

    "$ROOT/scripts/check.sh" || rc=$?
    [[ $rc -ne 0 ]] && return "$rc"

    "$ROOT/scripts/_residue_check.sh" check --seit "$vorher"
}

# ---------------------------------------------------------------------------
# Warum antwortet Docker nicht? Die Frage beantworten, statt zu raten.
#
# `docker info` taugt als DIAGNOSE nicht: es scheitert, wenn die Gruppe fehlt, UND
# in einer Shell, die älter ist als das `usermod` — dort ist die Mitgliedschaft längst
# erteilt, nur dieser Prozess kennt sie nicht. Wer daraus „Gruppe fehlt" schließt,
# vergibt ein root-äquivalentes Recht ein zweites Mal, ohne dass es nötig wäre.
#
#   id -nG "$me"  fragt die Gruppen-Datenbank   -> "darf der Benutzer?"
#   id -nG        fragt diesen Prozess          -> "weiß diese Shell davon?"
#
# Kein `cmd | grep -q`: unter `set -o pipefail` kann SIGPIPE die Pipeline auf 141
# setzen, obwohl grep 0 lieferte.
# ---------------------------------------------------------------------------
docker_diagnose() {
    local me; me="$(id -un)"
    if [[ " $(id -nG "$me") " == *" docker "* ]]; then
        if [[ " $(id -nG) " == *" docker "* ]]; then
            echo "Die Gruppe 'docker' ist aktiv — also antwortet der Daemon selbst nicht:"
            echo "    systemctl status docker"
        else
            echo "'$me' ist in der Gruppe 'docker', aber DIESE Shell kennt sie noch nicht"
            echo "(sie ist älter als das 'usermod'). Es fehlt kein Recht — nicht neu vergeben."
            echo "Denselben Push mit aktiver Gruppe fahren:"
            echo "    sg docker -c 'git push …'"
            echo "oder einmal ab- und wieder anmelden."
        fi
    else
        echo "'$me' ist nicht in der Gruppe 'docker':"
        echo "    sudo usermod -aG docker \"$me\"   (danach neu anmelden)"
    fi
    echo
    echo "Prüfen mit 'getent group docker' bzw. 'id -nG' — nie mit 'docker info'."
}

# Läuft der Hook bereits im Container, nie erneut eskalieren.
if [[ "${CI_LOCAL_INSIDE:-}" == "1" ]]; then
    exec "$ROOT/scripts/check.sh"
fi

# Git reicht auf stdin je Ref eine Zeile: <local ref> <local sha> <remote ref> <remote sha>
# Daraus lesen wir, ob main betroffen ist. Kein stdin (manueller Aufruf) => wie Feature-Branch,
# also die strenge Regel. Fail-closed ist hier die richtige Richtung.
pushes_main=0
refs_gesehen=0
refs_geloescht=0
refs_tag_geprueft=0
# Standardzweig der Gegenstelle (main, in älteren Repos master). Ohne Tracking-Ref
# (Push an eine URL, nie gefetcht) bleibt es leer — dann gibt es keine Tag-Ausnahme.
# Git übergibt den Namen der Gegenstelle als $1.
standard_ref=""
if [[ -n "${1:-}" ]]; then
    standard_ref="$(git symbolic-ref -q "refs/remotes/$1/HEAD" 2>/dev/null || true)"
    if [[ -z "$standard_ref" ]] && git rev-parse -q --verify "refs/remotes/$1/main" >/dev/null 2>&1; then
        standard_ref="refs/remotes/$1/main"
    fi
fi
# ---------------------------------------------------------------------------
# Hat die CI diesen Commit wirklich grün gesehen? (Kit 0.50.0, Register „Tag-Push-Annahme“)
#
# „Vorfahr von origin/main“ heißt nur, der Commit liegt dort. Dass die CI dort lief, ist eine
# Annahme: auf einem neuen Repo ohne Runner lief nie eine (connect-suite, 2026-11-05).
# Darum fragt der Hook GitHub: Jeder Pflicht-Check des Zweigs muss am Commit als Check-Run
# vorliegen und fertig und grün sein (success/neutral/skipped). Alles andere fährt die Suite:
# kein `gh`, kein Netz, Remote nicht GitHub, ein Pflicht-Check fehlt, läuft noch oder ist rot, ein Fehler irgendwo.
# Pflicht-Checks stehen im Branch-Schutz oder in Rulesets. Sind sie nicht lesbar oder keine gesetzt (privat ohne
# Bezahlplan: 403), gilt wie in pr-gruen „alle Läufe am Commit“: mindestens einer, alle fertig und grün, einer `success`.
# Es gibt kein „im Zweifel durch“. Der Grund geht auf stderr, damit man sieht, warum die Suite läuft.
#   ci_gruen <commit> <github-url> <zweig>   -> 0 nur bei „alle Pflicht-Checks grün“
# Nicht gelesen wird mit `--jq` (gh-eigen), nicht mit einer Pipe auf jq: ein Fehler von `gh`
# soll als Fehler ankommen, nicht als leere Liste.
# ---------------------------------------------------------------------------
ci_gruen() {
    local sha="$1" url="$2" zweig="$3" slug pflicht laeufe ctx
    command -v gh >/dev/null 2>&1 || { echo "pre-push: kein gh — Suite statt CI-Abfrage." >&2; return 1; }
    if [[ "$url" =~ github\.com[:/]([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)$ ]]; then
        slug="${BASH_REMATCH[1]%.git}"
    else
        echo "pre-push: Gegenstelle ist kein GitHub-Repo — Suite statt CI-Abfrage." >&2; return 1
    fi
    # Pflicht-Checks: Branch-Schutz, sonst Rulesets (wie pr-gruen). Privat ohne Bezahlplan liefert beides 403;
    # dann ist der Maßstab wie dort „alle Läufe am Commit“ (siehe unten), nicht „nichts“.
    pflicht="$(timeout 20 gh api "repos/$slug/branches/$zweig/protection/required_status_checks" \
        --jq '.contexts[]' 2>/dev/null)" || pflicht=""
    if [[ -z "$pflicht" ]]; then
        pflicht="$(timeout 20 gh api "repos/$slug/rules/branches/$zweig" \
            --jq '.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context' \
            2>/dev/null)" || pflicht=""
    fi
    laeufe="$(timeout 30 gh api --paginate "repos/$slug/commits/$sha/check-runs?per_page=100" \
        --jq '.check_runs[] | [.name, .status, (.conclusion // "-")] | @tsv' 2>/dev/null)" \
        || { echo "pre-push: Check-Runs von ${sha:0:9} nicht abfragbar — Suite." >&2; return 1; }
    if [[ -z "$pflicht" ]]; then
        # Kein Pflicht-Check les- oder gesetzt: Maßstab sind ALLE Läufe am Commit — mindestens einer, jeder fertig
        # und grün, mindestens einer echt `success` (nur übersprungene Läufe sind keine Abnahme).
        local erfolg=0
        while IFS=$'\t' read -r name status ergebnis; do
            [[ -n "$name" ]] || continue
            if [[ "$status" != "completed" || ! "$ergebnis" =~ ^(success|neutral|skipped)$ ]]; then
                echo "pre-push: Check '$name' am Commit ${sha:0:9}: $status/$ergebnis — Suite." >&2; return 1
            fi
            [[ "$ergebnis" == "success" ]] && erfolg=$((erfolg + 1))
        done <<< "$laeufe"
        if [[ "$erfolg" -eq 0 ]]; then
            echo "pre-push: keine grünen Check-Runs am Commit ${sha:0:9} (CI lief dort nie?) — Suite." >&2; return 1
        fi
        return 0
    fi
    while IFS= read -r ctx; do
        [[ -n "$ctx" ]] || continue
        local gesehen=0
        while IFS=$'\t' read -r name status ergebnis; do
            [[ "$name" == "$ctx" ]] || continue
            gesehen=$((gesehen + 1))
            if [[ "$status" != "completed" || ! "$ergebnis" =~ ^(success|neutral|skipped)$ ]]; then
                echo "pre-push: Pflicht-Check '$ctx' am Commit ${sha:0:9}: $status/$ergebnis — Suite." >&2; return 1
            fi
        done <<< "$laeufe"
        if [[ "$gesehen" -eq 0 ]]; then
            echo "pre-push: Pflicht-Check '$ctx' fehlt am Commit ${sha:0:9} — Suite." >&2; return 1
        fi
    done <<< "$pflicht"
    return 0
}

while read -r _local_ref local_sha remote_ref _remote_sha; do
    refs_gesehen=$((refs_gesehen + 1))
    [[ "$remote_ref" == "refs/heads/main" ]] && pushes_main=1
    # Beim LOESCHEN eines Zweigs (`git push origin --delete <zweig>`) ist die lokale SHA
    # vierzig Nullen. Git sagt es also deutlich — man muss nur hinsehen.
    if [[ "$local_sha" =~ ^0+$ ]]; then
        refs_geloescht=$((refs_geloescht + 1))
        continue
    fi
    # Tag auf einen Commit, der schon auf dem Standardzweig der Gegenstelle liegt: Dort kam er
    # nur über einen PR hin, und `pr-mergen` merged nur bei grüner CI am exakten Kopf. Die Suite
    # prüfte hier denselben Inhalt ein zweites Mal (12 min je Release, TinySesam 2026-09-27).
    # `merge-base` schält annotierte Tags selbst; zeigt ein Tag auf etwas anderes als einen
    # Commit, scheitert es — dann wird geprüft.
    # Seit 0.50.0 zusätzlich: die Pflicht-Checks des Commits sind bei GitHub grün (ci_gruen). Ohne das
    # gilt der Commit als ungeprüft und die Suite läuft.
    if [[ "$remote_ref" == refs/tags/* && -n "$standard_ref" ]] \
        && git merge-base --is-ancestor "$local_sha" "$standard_ref" 2>/dev/null \
        && ci_gruen "$(git rev-parse "$local_sha^{commit}")" "${2:-}" "${standard_ref##*/}"; then
        refs_tag_geprueft=$((refs_tag_geprueft + 1))
    fi
done || true

# Ein reiner Loesch-Push schiebt KEINEN Inhalt. Die Suite wuerde den lokalen HEAD pruefen —
# also etwas, das mit diesem Push nichts zu tun hat — und das kostet Minuten fuer einen Push
# ohne Inhalt. Gemessen in zwei Repos beim Aufraeumen gemergter Zweige (2026-09-24).
#
# Bedingung mit Bedacht: NUR wenn stdin ueberhaupt Zeilen hatte UND jede davon eine Loeschung
# war. Ohne stdin (manueller Aufruf) bleibt es bei der strengen Regel — fail-closed ist hier
# die richtige Richtung, und ein gemischter Push (loeschen + schieben) traegt Inhalt.
if [[ "$refs_gesehen" -gt 0 && "$refs_gesehen" -eq "$refs_geloescht" ]]; then
    echo "pre-push: reiner Loesch-Push ($refs_geloescht Ref(s)) — kein Inhalt, keine Suite."
    exit 0
fi

# Reiner Tag-Push auf bereits geprüfte Commits: dieselbe Strenge wie oben — NUR wenn stdin
# Zeilen hatte und JEDE davon entweder eine Löschung oder ein solcher Tag war. Ein Tag auf
# einen Commit abseits des Standardzweigs, ein veralteter Tracking-Ref oder ein gemischter
# Push mit Zweig fahren die Suite wie bisher.
if [[ "$refs_tag_geprueft" -gt 0 && "$refs_gesehen" -eq $((refs_tag_geprueft + refs_geloescht)) ]]; then
    echo "pre-push: reiner Tag-Push ($refs_tag_geprueft Tag(s)) auf Commits aus ${standard_ref#refs/remotes/} — dort laut GitHub grün (alle Pflicht-Checks), keine Suite."
    exit 0
fi

# ---- Repo-eigener Zusatz (Kit 0.29.0): `.githooks/pre-push.zusatz`, wenn das Repo einen hat.
# Dieser Hook gehört dem Kit und wird bei jedem Sync überschrieben. Repos mit einer Prüfung, die nur an
# DIESEM Rechner geht (LinuxTools: der Tower-Teil von check.sh — dragsnap mit cjs, die compose-Gegenprobe),
# hatten deshalb einen eigenen Hook und konnten das Kit nicht syncen, ohne ihn zu verlieren (2026-10-11).
# Der Zusatz läuft VOR der Suite und nach den Ausnahmen oben (ein Lösch- oder Tag-Push braucht ihn so wenig
# wie die Suite). Liegt er da, ist aber nicht ausführbar, bricht der Push ab: ein still übersprungener Zusatz
# wäre ein grüner Push ohne genau die Prüfung, für die es ihn gibt.
ZUSATZ="$ROOT/.githooks/pre-push.zusatz"
if [[ -e "$ZUSATZ" ]]; then
    if [[ ! -x "$ZUSATZ" ]]; then
        echo "pre-push: ABGEBROCHEN — $ZUSATZ liegt da, ist aber nicht ausführbar (chmod +x)." >&2
        exit 1
    fi
    echo "pre-push: repo-eigener Zusatz (.githooks/pre-push.zusatz)"
    ( cd "$ROOT" && "$ZUSATZ" </dev/null ) || { echo "pre-push: ABGEBROCHEN — der Zusatz ist rot." >&2; exit 1; }
fi

# Spiegelt den Autodetect von ci-local: erst direkt, dann passwortloses sudo.
# Ein interaktiver sudo-Prompt wäre hier falsch — der Hook darf nicht nach einem
# Passwort fragen, deshalb nur 'sudo -n'.
#
# Als FUNKTIONSTEST ist `docker info` richtig: gefragt ist nur „Container startbar?".
# Für die MELDUNG danach siehe docker_diagnose().
docker_ok() {
    command -v docker >/dev/null 2>&1 || return 1
    docker info >/dev/null 2>&1 && return 0
    sudo -n docker info >/dev/null 2>&1
}

# Text-Schnellweg VOR ci-local (Kit 0.40.0, 2026-10-31, Plan „Tempo“): check.sh fährt bei reinem Text nur die Hygiene —
# aber nur, wenn es die Liste der Änderungen kennt. Im Container von ci-local fehlt die Historie, und ci-local reicht
# CI_AENDERUNGEN nicht herein; ein Doku-Commit fuhr dort die volle Suite (FleetCommander: 8,5 min für eine Zeile).
# Hier, auf dem Rechner, ist der Standardzweig bekannt: _nur_text.sh entscheidet, test_repo.py prüft. Nur bei sauberem
# Arbeitsbaum — sonst prüfte die Hygiene einen anderen Stand als den gepushten, und es geht weiter wie bisher.
if [[ -x "$ROOT/scripts/_nur_text.sh" && -f "$ROOT/tests/test_repo.py" ]] \
    && ( cd "$ROOT" && git diff --quiet HEAD -- && [[ -z "$(git ls-files --others --exclude-standard)" ]] ) \
    && grund="$(cd "$ROOT" && scripts/_nur_text.sh)"; then
    echo "pre-push: $grund"
    ( cd "$ROOT" && python3 tests/test_repo.py ) || { echo "pre-push: ABGEBROCHEN — Repo-Hygiene rot." >&2; exit 1; }
    exit 0
fi

if command -v ci-local >/dev/null 2>&1; then
    if docker_ok; then
        # Grün-Marke (2026-10-29, Register „Rebase-Karussell“): lief GENAU dieser Baum (Tree-Hash)
        # mit derselben ci-local-Fassung und demselben Abbild schon grün — von Hand oder durch
        # einen früheren Push —, ist die Suite ein zweites Mal verschenkte Zeit (über eine Stunde
        # je Rebase im FleetCommander). Ein Rebase ohne Inhaltsänderung lässt den Baum gleich;
        # jede Inhaltsänderung, ein anderes ci-local oder ein neues Abbild macht ihn ungültig.
        # Die Marke legt nur ein GRÜNER Standard-/--full-Lauf von ci-local an; ein ci-local ohne
        # `--gruen-pruefen` (älter) scheitert hier und fährt die Suite wie bisher. Kein Ersatz für
        # die CI auf GitHub, nur für den identischen zweiten lokalen Lauf.
        if ( cd "$ROOT" && ci-local --gruen-pruefen ); then
            echo "pre-push: Suite entfällt — genau dieser Stand war schon grün (Grün-Marke von ci-local)."
            exit 0
        fi
        echo "pre-push: Testsuite läuft im Container (ci-local) — das dauert, und das ist gut so."
        # Ein einfacher Lauf. Den Doppellauf (--full), der die Wiederholbarkeit beweist,
        # fährt die CI bzw. der Release — nicht die kurze Schleife vor jedem Push.
        exec ci-local
    fi
    if [[ "$pushes_main" -eq 0 ]]; then
        {
            echo
            echo "pre-push: ABGEBROCHEN — ci-local ist eingerichtet, aber Docker antwortet nicht."
            echo
            echo "Auf Feature-Branches läuft keine CI. Der Container-Lauf ist hier die"
            echo "einzige Prüfung; ein Rückfall auf den Host würde ungeprüften Code durchlassen."
            echo
            docker_diagnose
        } >&2
        exit 1
    fi
    echo "pre-push: Docker antwortet nicht → nativer Lauf." >&2
    echo "          Erlaubt, weil auf main anschließend die CI greift." >&2
fi

run_native_with_residue_check
