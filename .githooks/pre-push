#!/usr/bin/env bash
# The last brake before a push — from the shared kit (repokit), do not edit by hand.
# Enable: git config core.hooksPath .githooks · Emergency exit (only with good reason): git push --no-verify
#
# FAST BY DEFAULT (kit 0.59.0, PO 2026-11-23): `ci-local` and "scripts/check.sh twice green" are no longer required
# before a push. The full suite runs in the PR CI (self-hosted runners for private repos), and repeatability is shown
# by the nightly repeat run (`repokit wiederholung`, workflow nightly-repeat). The hook only runs what answers in
# seconds to a few minutes (target < 3 min) and catches what would otherwise cost a CI round:
#
#   text only (scripts/_nur_text.sh)  -> tests/test_repo.py (hygiene with the text check), nothing else
#   otherwise                         -> tests/test_repo.py (no private infrastructure, secret patterns, kit manifest),
#                                        format/lint of the changed files and the tests of the changed code:
#                                        shell (bash -n, shellcheck), Python (py_compile, ruff where configured,
#                                        affected tests/test_*.py), Go (gofmt, go vet with the repo's GO_PRUEF_TAGS,
#                                        go test of the tag-less packages, of the changed packages), Rust (cargo fmt
#                                        --check, clippy, cargo test of the changed workspaces), JS/TS (biome check)
#   .githooks/pre-push.zusatz         -> the repo's own extra (kit 0.29.0), e.g. its own fast tests
#
# A missing tool is a visible note, not a red push: the gate is the PR CI, which has every tool. That holds for the tools
# the hook calls itself AND for a test file of the changed code: a test that lacks a prerequisite here (Docker, ansible,
# a service) ends with exit 77 (the automake "skipped" code, kit 0.65.0). The hook shows it as NOT checked — never as
# green, never as red; the PR CI runs it. Any other non-zero exit is red. Skip is no green in the full suite either:
# what scripts/check.sh makes of exit 77 is the repo's choice.
#
# FULL RUN ON REQUEST: `PREPUSH_VOLL=1 git push …` runs what the hook did up to kit 0.58: `ci-local` (container,
# with CI_LOCAL_AUSWEICHEN=knoten) if it is installed, else scripts/check.sh natively plus the residue check. For
# debugging, not a duty. `ci-local` itself stays callable by hand as before.
#
# EXACTLY THE PUSHED COMMIT (kit 0.59.0): Up to 0.58 the hook checked the working tree — `git push origin other`
# from another branch, or a push with uncommitted changes, checked something that was not pushed. Now every pushed
# commit is checked as it is: in place if it is HEAD and the working tree is clean, otherwise in a temporary
# worktree (`git worktree add --detach`, removed afterwards). Limit: a Python package installed editable from the
# main working tree (.venv) still points there; tests that import it by name see the working tree's code.
#
# Unchanged: a pure delete push and a pure tag push on commits that GitHub saw green skip everything (T-4, T-11).
# The green mark of ci-local (kit 0.39.0) is no longer read: the fast path does not need it, and a full run on
# request must not be skipped.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
# Git hands the hook GIT_DIR & co. In a temporary worktree they would point every git call at the wrong tree.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR
# Target time of the fast path in seconds; above it the hook says so (it never aborts a green check for being slow).
FRIST="${PREPUSH_FRIST:-180}"
# The user's tool folders (kit 0.65.0): git runs hooks from GUIs and non-login shells whose PATH lacks ~/.cargo/bin or
# ~/go/bin. The Rust and Go stages then said "no cargo here" although cargo was installed (PO todo, PWM-Control).
for _werkzeug in "$HOME/.cargo/bin" "$HOME/go/bin" /usr/local/go/bin; do
    if [[ -d "$_werkzeug" && ":$PATH:" != *":$_werkzeug:"* ]]; then PATH="$PATH:$_werkzeug"; fi
done
unset _werkzeug

# ---------------------------------------------------------------------------
# Nativer Lauf + Rückstands-Check (nur noch im vollen Lauf, PREPUSH_VOLL=1).
#
# Verglichen wird gegen den Zustand VOR dem Lauf, damit ein bereits schmutziger Arbeitsbaum nicht fälschlich als
# Rückstand gilt. Die Prüfung selbst steht in `scripts/_residue_check.sh` — derselben Datei, die auch die GitHub-CI
# fährt.
# ---------------------------------------------------------------------------
run_native_with_residue_check() {
    local vorher rc=0

    if [[ ! -x scripts/_residue_check.sh ]]; then
        echo "pre-push: ABGEBROCHEN — scripts/_residue_check.sh fehlt." >&2
        echo "Ohne den Rückstands-Check ist der native Lauf kein Netz." >&2
        echo "Auf dem Tower: repokit sync" >&2
        return 1
    fi

    vorher="$(mktemp)"
    # shellcheck disable=SC2064
    trap "rm -f '$vorher'" RETURN

    scripts/_residue_check.sh snapshot > "$vorher"

    scripts/check.sh || rc=$?
    [[ $rc -ne 0 ]] && return "$rc"

    scripts/_residue_check.sh check --seit "$vorher"
}

# ---------------------------------------------------------------------------
# Warum antwortet Docker nicht? Die Frage beantworten, statt zu raten.
#
#   id -nG "$me"  fragt die Gruppen-Datenbank   -> "darf der Benutzer?"
#   id -nG        fragt diesen Prozess          -> "weiß diese Shell davon?"
#
# Kein `cmd | grep -q`: unter `set -o pipefail` kann SIGPIPE die Pipeline auf 141 setzen, obwohl grep 0 lieferte.
# ---------------------------------------------------------------------------
docker_diagnose() {
    local me; me="$(id -un)"
    if [[ " $(id -nG "$me") " == *" docker "* ]]; then
        if [[ " $(id -nG) " == *" docker "* ]]; then
            echo "Die Gruppe 'docker' ist aktiv — also antwortet der Daemon selbst nicht:"
            echo "    systemctl status docker"
        else
            echo "'$me' ist in der Gruppe 'docker', aber DIESE Shell kennt sie noch nicht"
            echo "(sie ist älter als das 'usermod'). Es fehlt kein Recht — nicht neu vergeben."
            echo "Denselben Push mit aktiver Gruppe fahren:"
            echo "    sg docker -c 'git push …'"
            echo "oder einmal ab- und wieder anmelden."
        fi
    else
        echo "'$me' ist nicht in der Gruppe 'docker':"
        echo "    sudo usermod -aG docker \"$me\"   (danach neu anmelden)"
    fi
    echo
    echo "Prüfen mit 'getent group docker' bzw. 'id -nG' — nie mit 'docker info'."
}

# Läuft der Hook bereits im Container, nie erneut eskalieren.
if [[ "${CI_LOCAL_INSIDE:-}" == "1" ]]; then
    exec scripts/check.sh
fi

# Git reicht auf stdin je Ref eine Zeile: <local ref> <local sha> <remote ref> <remote sha>
refs_gesehen=0
refs_geloescht=0
refs_tag_geprueft=0
pruefen=()          # pushed objects that carry content and need a check (deduplicated below)
# Standardzweig der Gegenstelle (main, in älteren Repos master). Ohne Tracking-Ref
# (Push an eine URL, nie gefetcht) bleibt es leer — dann gibt es keine Tag-Ausnahme.
# Git übergibt den Namen der Gegenstelle als $1.
standard_ref=""
if [[ -n "${1:-}" ]]; then
    standard_ref="$(git symbolic-ref -q "refs/remotes/$1/HEAD" 2>/dev/null || true)"
    if [[ -z "$standard_ref" ]] && git rev-parse -q --verify "refs/remotes/$1/main" >/dev/null 2>&1; then
        standard_ref="refs/remotes/$1/main"
    fi
fi
# ---------------------------------------------------------------------------
# Hat die CI diesen Commit wirklich grün gesehen? (Kit 0.50.0, Register „Tag-Push-Annahme“)
#
# „Vorfahr von origin/main“ heißt nur, der Commit liegt dort. Dass die CI dort lief, ist eine
# Annahme: auf einem neuen Repo ohne Runner lief nie eine (gefunden bei einem neuen Repo, 2026-11-05).
# Darum fragt der Hook GitHub: Jeder Pflicht-Check des Zweigs muss am Commit als Check-Run
# vorliegen und fertig und grün sein (success/neutral/skipped). Alles andere fährt die Suite:
# kein `gh`, kein Netz, Remote nicht GitHub, ein Pflicht-Check fehlt, läuft noch oder ist rot, ein Fehler irgendwo.
# Pflicht-Checks stehen im Branch-Schutz oder in Rulesets. Sind sie nicht lesbar oder keine gesetzt (privat ohne
# Bezahlplan: 403), gilt wie in pr-gruen „alle Läufe am Commit“: mindestens einer, alle fertig und grün, einer `success`.
# Es gibt kein „im Zweifel durch“. Der Grund geht auf stderr, damit man sieht, warum die Suite läuft.
#   ci_gruen <commit> <github-url> <zweig>   -> 0 nur bei „alle Pflicht-Checks grün“
# Nicht gelesen wird mit `--jq` (gh-eigen), nicht mit einer Pipe auf jq: ein Fehler von `gh`
# soll als Fehler ankommen, nicht als leere Liste.
# ---------------------------------------------------------------------------
ci_gruen() {
    local sha="$1" url="$2" zweig="$3" slug pflicht laeufe ctx
    command -v gh >/dev/null 2>&1 || { echo "pre-push: kein gh — Suite statt CI-Abfrage." >&2; return 1; }
    if [[ "$url" =~ github\.com[:/]([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)$ ]]; then
        slug="${BASH_REMATCH[1]%.git}"
    else
        echo "pre-push: Gegenstelle ist kein GitHub-Repo — Suite statt CI-Abfrage." >&2; return 1
    fi
    # Pflicht-Checks: Branch-Schutz, sonst Rulesets (wie pr-gruen). Privat ohne Bezahlplan liefert beides 403;
    # dann ist der Maßstab wie dort „alle Läufe am Commit“ (siehe unten), nicht „nichts“.
    pflicht="$(timeout 20 gh api "repos/$slug/branches/$zweig/protection/required_status_checks" \
        --jq '.contexts[]' 2>/dev/null)" || pflicht=""
    if [[ -z "$pflicht" ]]; then
        pflicht="$(timeout 20 gh api "repos/$slug/rules/branches/$zweig" \
            --jq '.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context' \
            2>/dev/null)" || pflicht=""
    fi
    laeufe="$(timeout 30 gh api --paginate "repos/$slug/commits/$sha/check-runs?per_page=100" \
        --jq '.check_runs[] | [.name, .status, (.conclusion // "-")] | @tsv' 2>/dev/null)" \
        || { echo "pre-push: Check-Runs von ${sha:0:9} nicht abfragbar — Suite." >&2; return 1; }
    if [[ -z "$pflicht" ]]; then
        # Kein Pflicht-Check les- oder gesetzt: Maßstab sind ALLE Läufe am Commit — mindestens einer, jeder fertig
        # und grün, mindestens einer echt `success` (nur übersprungene Läufe sind keine Abnahme).
        local erfolg=0
        while IFS=$'\t' read -r name status ergebnis; do
            [[ -n "$name" ]] || continue
            if [[ "$status" != "completed" || ! "$ergebnis" =~ ^(success|neutral|skipped)$ ]]; then
                echo "pre-push: Check '$name' am Commit ${sha:0:9}: $status/$ergebnis — Suite." >&2; return 1
            fi
            [[ "$ergebnis" == "success" ]] && erfolg=$((erfolg + 1))
        done <<< "$laeufe"
        if [[ "$erfolg" -eq 0 ]]; then
            echo "pre-push: keine grünen Check-Runs am Commit ${sha:0:9} (CI lief dort nie?) — Suite." >&2; return 1
        fi
        return 0
    fi
    while IFS= read -r ctx; do
        [[ -n "$ctx" ]] || continue
        local gesehen=0
        while IFS=$'\t' read -r name status ergebnis; do
            [[ "$name" == "$ctx" ]] || continue
            gesehen=$((gesehen + 1))
            if [[ "$status" != "completed" || ! "$ergebnis" =~ ^(success|neutral|skipped)$ ]]; then
                echo "pre-push: Pflicht-Check '$ctx' am Commit ${sha:0:9}: $status/$ergebnis — Suite." >&2; return 1
            fi
        done <<< "$laeufe"
        if [[ "$gesehen" -eq 0 ]]; then
            echo "pre-push: Pflicht-Check '$ctx' fehlt am Commit ${sha:0:9} — Suite." >&2; return 1
        fi
    done <<< "$pflicht"
    return 0
}

while read -r _local_ref local_sha remote_ref _remote_sha; do
    refs_gesehen=$((refs_gesehen + 1))
    # Beim LOESCHEN eines Zweigs (`git push origin --delete <zweig>`) ist die lokale SHA
    # vierzig Nullen. Git sagt es also deutlich — man muss nur hinsehen.
    if [[ "$local_sha" =~ ^0+$ ]]; then
        refs_geloescht=$((refs_geloescht + 1))
        continue
    fi
    # Tag auf einen Commit, der schon auf dem Standardzweig der Gegenstelle liegt: Dort kam er
    # nur über einen PR hin, und `pr-mergen` merged nur bei grüner CI am exakten Kopf.
    # `merge-base` schält annotierte Tags selbst; zeigt ein Tag auf etwas anderes als einen
    # Commit, scheitert es — dann wird geprüft.
    # Seit 0.50.0 zusätzlich: die Pflicht-Checks des Commits sind bei GitHub grün (ci_gruen).
    if [[ "$remote_ref" == refs/tags/* && -n "$standard_ref" ]] \
        && git merge-base --is-ancestor "$local_sha" "$standard_ref" 2>/dev/null \
        && ci_gruen "$(git rev-parse "$local_sha^{commit}")" "${2:-}" "${standard_ref##*/}"; then
        refs_tag_geprueft=$((refs_tag_geprueft + 1))
        continue
    fi
    pruefen+=("$local_sha")
done || true

# Ein reiner Loesch-Push schiebt KEINEN Inhalt. NUR wenn stdin ueberhaupt Zeilen hatte UND jede davon eine Loeschung
# war; ohne stdin (manueller Aufruf) wird geprüft — fail-closed.
if [[ "$refs_gesehen" -gt 0 && "$refs_gesehen" -eq "$refs_geloescht" ]]; then
    echo "pre-push: reiner Loesch-Push ($refs_geloescht Ref(s)) — kein Inhalt, keine Suite."
    exit 0
fi

# Reiner Tag-Push auf bereits geprüfte Commits: NUR wenn stdin Zeilen hatte und JEDE davon entweder eine Löschung
# oder ein solcher Tag war. Ein gemischter Push prüft die übrigen Refs (unten).
if [[ "$refs_tag_geprueft" -gt 0 && "$refs_gesehen" -eq $((refs_tag_geprueft + refs_geloescht)) ]]; then
    echo "pre-push: reiner Tag-Push ($refs_tag_geprueft Tag(s)) auf Commits aus ${standard_ref#refs/remotes/} — dort laut GitHub grün (alle Pflicht-Checks), keine Suite."
    exit 0
fi

# No stdin (manual call): check HEAD — fail-closed, as before.
if [[ "$refs_gesehen" -eq 0 ]]; then
    echo "pre-push: no refs on stdin (manual call) — checking HEAD."
    pruefen=(HEAD)
fi

# Pushed objects -> commits, deduplicated in push order. A tag on a tree or blob has no commit to check out; then the
# working tree's HEAD is checked, as before 0.59.0 (fail-closed: something is always checked).
commits=()
declare -A schon=()
for obj in "${pruefen[@]}"; do
    if ! c="$(git rev-parse -q --verify "$obj^{commit}" 2>/dev/null)"; then
        echo "pre-push: ${obj:0:12} is not a commit — checking HEAD instead."
        c="$(git rev-parse HEAD)"
    fi
    [[ -n "${schon[$c]+x}" ]] && continue
    schon[$c]=1
    commits+=("$c")
done

# Base for "what changed": merge-base with the default branch of the remote (as scripts/_nur_text.sh finds it).
gegenstelle="${1:-origin}"
standard_basis=""
for k in "$standard_ref" "refs/remotes/$gegenstelle/HEAD" "refs/remotes/$gegenstelle/main" \
         "refs/remotes/$gegenstelle/master" refs/remotes/origin/HEAD refs/remotes/origin/main refs/remotes/origin/master; do
    [[ -n "$k" ]] || continue
    if git rev-parse -q --verify "$k^{commit}" >/dev/null 2>&1; then standard_basis="$k"; break; fi
done

# ---------------------------------------------------------------------------
# A checkout of exactly the pushed commit: in place if it is HEAD and the working tree is clean, else a temporary
# worktree. Sets DIR and WO. The temporary directory carries the repo's name (ci-local reads it in a full run).
# ---------------------------------------------------------------------------
temp_verz=()
aufraeumen() {
    local v
    for v in "${temp_verz[@]}"; do
        git -C "$ROOT" worktree remove --force "$v/${ROOT##*/}" >/dev/null 2>&1 || true
        rm -rf "$v"
    done
    git -C "$ROOT" worktree prune >/dev/null 2>&1 || true
}
trap aufraeumen EXIT

bereitstellen() {
    local c="$1" v
    if [[ "$c" == "$(git rev-parse HEAD)" ]] && git diff --quiet HEAD -- 2>/dev/null \
        && [[ -z "$(git ls-files --others --exclude-standard)" ]]; then
        DIR="$ROOT"; WO="working tree (HEAD ${c:0:9}, clean)"
        return 0
    fi
    v="$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")"
    temp_verz+=("$v")
    DIR="$v/${ROOT##*/}"
    if ! git worktree add -q --detach "$DIR" "$c" >/dev/null 2>&1; then
        echo "pre-push: ABGEBROCHEN — temporary worktree of ${c:0:9} could not be created (git worktree add)." >&2
        return 1
    fi
    WO="temporary worktree of ${c:0:9} (not HEAD, or the working tree has changes that are not pushed)"
}

# Spiegelt den Autodetect von ci-local: erst direkt, dann passwortloses sudo (nie ein Passwort-Prompt im Hook).
# Als FUNKTIONSTEST ist `docker info` richtig: gefragt ist nur „Container startbar?". Für die MELDUNG docker_diagnose().
docker_ok() {
    command -v docker >/dev/null 2>&1 || return 1
    docker info >/dev/null 2>&1 && return 0
    sudo -n docker info >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Full run on request (PREPUSH_VOLL=1): ci-local if installed, else check.sh natively with the residue check.
# Runs in the checkout of the pushed commit (cwd). No silent fallback: ci-local installed but Docker down aborts.
# ---------------------------------------------------------------------------
voll() {
    if command -v ci-local >/dev/null 2>&1; then
        if docker_ok; then
            echo "pre-push: PREPUSH_VOLL=1 — full suite in the container (ci-local)."
            # Ausweichen (Kit 0.56.0): ist hier kein ci-local-Platz frei, darf ci-local auf einen freien CI-Knoten
            # ausweichen. Abschalten für einen Push: CI_LOCAL_AUSWEICHEN=aus PREPUSH_VOLL=1 git push …
            CI_LOCAL_AUSWEICHEN="${CI_LOCAL_AUSWEICHEN:-knoten}" ci-local
            return
        fi
        {
            echo
            echo "pre-push: ABGEBROCHEN — PREPUSH_VOLL=1 and ci-local is installed, but Docker does not answer."
            echo
            docker_diagnose
        } >&2
        return 1
    fi
    echo "pre-push: PREPUSH_VOLL=1 — full suite natively (scripts/check.sh + residue check)."
    run_native_with_residue_check
}

# ---------------------------------------------------------------------------
# The fast path. Runs in the checkout of the pushed commit (cwd); $1 = base commit (empty: none known).
# ---------------------------------------------------------------------------
hinweis() { echo "  – $1"; }
stufe() { printf '\n▸ %s\n' "$1"; }
rot() { echo "pre-push: ABGEBROCHEN — $1" >&2; exit 1; }

# Does the repo's own suite use this tool? Lint tools run only then — a repo that never adopted ruff or shellcheck
# must not turn red on a changed legacy file because the tool happens to be installed here.
nutzt() {
    local f
    for f in scripts/check.sh .github/workflows/*.yml .github/workflows/*.yaml; do
        [[ -f "$f" ]] || continue
        # The name as a word before any `#` on its line (a comment that names the tool is no use of it). One grep, no
        # pipe: `grep -v … | grep -q` under pipefail can turn a hit into 141 (SIGPIPE) and read as "not used".
        if grep -q -E -e "^[^#]*(^|[^[:alnum:]_-])$1([^[:alnum:]_-]|\$)" "$f"; then return 0; fi
    done
    return 1
}

# nearest_with <file> <name> — the nearest directory (from the file's folder up to the repo root) holding <name>.
naechster_mit() {
    local d
    d="$(dirname "$1")"
    while :; do
        if [[ -e "$d/$2" ]]; then printf '%s' "$d"; return 0; fi
        [[ "$d" == "." ]] && return 1
        d="$(dirname "$d")"
    done
}

# python_waehlen — the interpreter for hygiene AND tests of the changed files (one choice, kit 0.61.0). Order: $PYTHON
# (binding), .venv of the checked-out tree, .venv of the tree the hook was started in, .venv of the repo's main working
# tree (a fresh `git worktree add` has none), else system python3. Sets PY_WAHL and PY_ART (gesetzt|venv|system).
# WHY: up to 0.60 the hygiene stage called a bare `python3`, only the tests of the changed files looked for .venv. A repo
# whose hygiene imports a package (TinySesam: FastAPI, runs README code blocks) died with ModuleNotFoundError in every
# fresh worktree, although the .venv was right there.
python_waehlen() {
    local c haupt
    PY_WAHL=""; PY_ART=venv
    if [[ -n "${PYTHON:-}" ]]; then PY_WAHL="$PYTHON"; PY_ART=gesetzt; return 0; fi
    haupt="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    for c in "$PWD/.venv/bin/python" "$ROOT/.venv/bin/python" ${haupt:+"${haupt%/.git}/.venv/bin/python"}; do
        if [[ -x "$c" ]]; then PY_WAHL="$c"; return 0; fi
    done
    PY_WAHL=python3; PY_ART=system
}

# hygiene — runs tests/test_repo.py with the chosen interpreter. A missing package with only the system python3 on offer
# is not a finding in the repo but a missing venv: say so, with the way out, instead of a bare traceback.
hygiene() {
    local aus rc=0
    python_waehlen
    aus="$(mktemp)"
    "$PY_WAHL" tests/test_repo.py >"$aus" 2>&1 || rc=$?
    cat "$aus"
    if [[ $rc -ne 0 && "$PY_ART" == system ]] && grep -q -E '^(ModuleNotFoundError|ImportError)' "$aus"; then
        rm -f "$aus"
        rot "repo hygiene could not import a package — venv missing (no .venv here, in the hook's tree or in the main tree). Build it: run scripts/check.sh once (repos with uv build .venv there) or \`uv venv .venv && uv pip install -e '.[all]'\`, or set PYTHON=<interpreter>, then push again."
    fi
    rm -f "$aus"
    [[ $rc -eq 0 ]] || rot "repo hygiene is red (tests/test_repo.py)."
}

# skript_test <file> — is this test file a SCRIPT (run it with the interpreter) rather than a pytest/unittest module?
# Yes if it has a `__main__` guard, or if it defines no test function and no test class at all: then its checks run at
# module level and end in `raise SystemExit(...)` (kit 0.62.0; the guard-only rule called such a file "no __main__" and
# skipped it in the fast push, TinySesam tests/test_english_code.py).
skript_test() {
    grep -q -E '^if __name__ == .__main__.:' "$1" && return 0
    grep -q -E '^[[:space:]]*(async[[:space:]]+)?def test_|^class Test|unittest|import pytest|from pytest' "$1" && return 1
    return 0
}

# Build tags of the repo (kit 0.63.0): env GO_PRUEF_TAGS, else the assignment `GO_PRUEF_TAGS="a b"` in scripts/check.sh
# (the same variable scripts/_go_check.sh reads; blank-separated, one vet pass per tag).
go_tags() {
    if [[ -n "${GO_PRUEF_TAGS:-}" ]]; then printf '%s' "$GO_PRUEF_TAGS"; return 0; fi
    [[ -f scripts/check.sh ]] || return 0
    sed -n -E "s/^[[:space:]]*(export[[:space:]]+)?GO_PRUEF_TAGS=[\"']?([^\"'#]*).*/\2/p" scripts/check.sh | head -n 1
}

# go_listen <tag|""> <pattern…> — import paths of the packages that HAVE Go files (tests included) under that tag.
go_listen() {
    local tag="$1"; shift
    local -a opt=(-e)
    [[ -n "$tag" ]] && opt+=(-tags "$tag")
    go list "${opt[@]}" -f '{{if or .GoFiles .CgoFiles .TestGoFiles .XTestGoFiles}}{{.ImportPath}}{{end}}' "$@"
}

# go_pruefen <pattern…>: go vet with the repo's tags, go test only for packages that have files without tags (kit 0.63.0).
# A package whose files all sit behind a build tag makes a tag-less `go vet` fail ("build constraints exclude all
# Go files"): it is vetted per tag instead. Its tests are browser/service tests and stay in the PR CI. A package with no
# Go files even with the tags is shown as NOT checked, never counted as green.
go_pruefen() {
    local out p t q gefunden
    local -a alle_p=() ohne=() mit_tag=() tagliste=()
    local -a vet_gedeckt=()
    out="$(go list -e -f '{{.ImportPath}}' "$@")" || rot "go list"
    mapfile -t alle_p <<<"$out"
    out="$(go_listen "" "$@")" || rot "go list"
    [[ -z "$out" ]] || mapfile -t ohne <<<"$out"
    read -r -a tagliste <<<"$(go_tags)"
    if [[ ${#ohne[@]} -gt 0 ]]; then
        echo "  go vet + go test: ${ohne[*]}"
        go vet "${ohne[@]}" || rot "go vet"
        go test "${ohne[@]}" || rot "go test"
        vet_gedeckt=("${ohne[@]}")
    fi
    for t in "${tagliste[@]}"; do
        out="$(go_listen "$t" "$@")" || rot "go list -tags $t"
        [[ -n "$out" ]] || continue
        mapfile -t mit_tag <<<"$out"
        echo "  go vet -tags $t: ${mit_tag[*]}"
        go vet -tags "$t" "${mit_tag[@]}" || rot "go vet -tags $t"
        vet_gedeckt+=("${mit_tag[@]}")
    done
    for p in "${alle_p[@]}"; do
        [[ -n "$p" ]] || continue
        gefunden=0; for q in "${ohne[@]}"; do [[ "$q" == "$p" ]] && gefunden=1; done
        [[ $gefunden -eq 0 ]] || continue
        gefunden=0; for q in "${vet_gedeckt[@]}"; do [[ "$q" == "$p" ]] && gefunden=1; done
        if [[ $gefunden -eq 1 ]]; then
            hinweis "$p: tagged only — vetted with its tags, tests in the PR CI"
        else
            hinweis "$p: no Go files, not even with the tags (${tagliste[*]:-none set}) — NOT checked (GO_PRUEF_TAGS?)"
        fi
    done
}

schnell() {
    local basis="$1" grund="" py f d
    local -a geaendert=() alle=() sh=() pyf=() tests=() go=() gopakete=() rs=() js=()

    # 1. Text only: hygiene with the text check, nothing else (kit 0.40.0).
    if [[ -x scripts/_nur_text.sh && -f tests/test_repo.py ]]; then
        if grund="$(scripts/_nur_text.sh)"; then
            echo "pre-push: $grund"
            hygiene
            return 0
        fi
        echo "pre-push: $grund — fast checks instead (full suite: PR CI)."
    fi

    # 2. Hygiene: no private infrastructure, no secret patterns, kit manifest.
    stufe "Hygiene (tests/test_repo.py)"
    if [[ -f tests/test_repo.py ]]; then
        hygiene
    else
        hinweis "no tests/test_repo.py — the hygiene runs only in the PR CI"
    fi

    if [[ -z "$basis" ]]; then
        hinweis "no default branch known (no base) — the changed files are unknown; tests of the changes: PR CI"
        return 0
    fi
    # Changed files since the merge-base: `geaendert` the ones that still exist, `alle` with deletions (Go packages).
    mapfile -d '' -t alle < <(git diff -z --name-only --no-renames "$basis" HEAD)
    for f in "${alle[@]}"; do
        [[ -f "$f" && ! -L "$f" ]] && geaendert+=("$f")
    done
    if [[ ${#alle[@]} -eq 0 ]]; then
        hinweis "no change against ${basis:0:9} — nothing more to check"
        return 0
    fi
    for f in "${geaendert[@]}"; do
        case "$f" in
            *.sh) sh+=("$f") ;;
            *.py) pyf+=("$f") ;;
            *.go) go+=("$f") ;;
            *.rs) rs+=("$f") ;;
            *.js|*.mjs|*.cjs|*.jsx|*.ts|*.mts|*.cts|*.tsx) js+=("$f") ;;
            *.md|*.json|*.yml|*.yaml|*.toml|*.txt|*.html|*.css) ;;
            *)  # a script without extension: by its shebang
                if [[ "$(head -c 64 "$f" 2>/dev/null | head -n 1)" =~ ^#!.*[/[:space:]](ba)?sh([[:space:]]|$) ]]; then
                    sh+=("$f")
                fi ;;
        esac
    done

    # 3. Shell: syntax always, shellcheck where the repo uses it.
    if [[ ${#sh[@]} -gt 0 ]]; then
        stufe "Shell (${#sh[@]} file(s))"
        for f in "${sh[@]}"; do bash -n "$f" || rot "$f: bash -n (syntax)"; done
        if nutzt shellcheck; then
            if command -v shellcheck >/dev/null 2>&1; then
                # -x like scripts/check.sh (kit 0.65.0): without it every script with `source` is red (SC1091, info).
                shellcheck -x "${sh[@]}" || rot "shellcheck"
                echo "  shellcheck clean"
            else
                hinweis "shellcheck is not installed here — PR CI"
            fi
        fi
    fi

    # 4. Python: syntax (no .pyc written), ruff where configured.
    if [[ ${#pyf[@]} -gt 0 ]]; then
        stufe "Python (${#pyf[@]} file(s))"
        python3 -c 'import ast, sys
for f in sys.argv[1:]:
    ast.parse(open(f, "rb").read(), f)' "${pyf[@]}" || rot "Python syntax"
        if nutzt ruff; then
            if command -v ruff >/dev/null 2>&1; then
                ruff check "${pyf[@]}" || rot "ruff check"
                ruff format --check "${pyf[@]}" || rot "ruff format --check"
            else
                hinweis "ruff is not installed here — PR CI"
            fi
        fi
    fi

    # 4b. Affected Python tests: a changed test file itself (test_*.py anywhere, check_*.py under a tests/ folder), and
    # for a changed Python or shell file <name>.py/<name>.sh/<name>: **/test_<name>.py and **/tests/**/check_<name>.py
    # ("-" in the name read as "_"). Two naming schemes the repos use; a repo with another one adds its own fast tests
    # in .githooks/pre-push.zusatz. `PREPUSH_TESTS=aus git push` skips this stage for one push (with a note).
    local -A gesehen=()
    for f in "${pyf[@]}" "${sh[@]}"; do
        local -a kandidaten=()
        local name="${f##*/}"
        if [[ "$name" == test_*.py ]] || [[ "$name" == check_*.py && "$f" =~ (^|/)tests/ ]]; then
            kandidaten=("$f")
        else
            name="${name%.py}"; name="${name%.sh}"; name="${name//-/_}"
            mapfile -t kandidaten < <(git ls-files -- ":(glob)**/test_${name}.py" ":(glob)**/tests/**/check_${name}.py")
        fi
        for d in "${kandidaten[@]}"; do
            [[ "$d" == tests/test_repo.py || "$d" == tests/_kit/* || -n "${gesehen[$d]+x}" || ! -f "$d" ]] && continue
            gesehen[$d]=1
            tests+=("$d")
        done
    done
    if [[ ${#pyf[@]} -gt 0 || ${#sh[@]} -gt 0 ]]; then
        stufe "Tests of the changed files (${#tests[@]})"
        if [[ "${PREPUSH_TESTS:-}" == aus ]]; then
            hinweis "PREPUSH_TESTS=aus — skipped for this push; the PR CI runs them"
        elif [[ ${#tests[@]} -eq 0 ]]; then
            hinweis "no test file belongs to the changed files by name — PR CI"
        else
            python_waehlen; py="$PY_WAHL"
            local trc
            for d in "${tests[@]}"; do
                if skript_test "$d"; then
                    echo "  $d"
                    trc=0; "$py" "$d" || trc=$?
                    if [[ $trc -eq 77 ]]; then
                        hinweis "$d skipped itself (exit 77: a prerequisite is missing here) — NOT checked here, PR CI"
                    elif [[ $trc -ne 0 ]]; then
                        rot "$d is red"
                    fi
                elif "$py" -c 'import pytest' >/dev/null 2>&1; then
                    echo "  pytest $d"
                    "$py" -m pytest -q "$d" || rot "$d is red (pytest)"
                else
                    hinweis "$d: not a script and no pytest for $py — PR CI"
                fi
            done
        fi
    fi

    # 5. Go: gofmt of the changed files, go vet + go test of the changed packages of the root module.
    local gomod=0
    for f in "${alle[@]}"; do [[ "$f" == go.mod || "$f" == go.sum ]] && gomod=1; done
    if [[ -f go.mod && ( ${#go[@]} -gt 0 || $gomod -eq 1 || " ${alle[*]} " == *".go "* ) ]]; then
        stufe "Go"
        if command -v go >/dev/null 2>&1; then
            if [[ ${#go[@]} -gt 0 ]]; then
                local unformatiert
                unformatiert="$(gofmt -l "${go[@]}")"
                [[ -z "$unformatiert" ]] || rot "not gofmt-formatted:"$'\n'"$unformatiert"
                echo "  gofmt clean (${#go[@]} file(s))"
            fi
            if [[ $gomod -eq 1 ]]; then
                gopakete=(./...)
            else
                declare -A pk=()
                for f in "${alle[@]}"; do
                    [[ "$f" == *.go ]] || continue
                    d="$(dirname "$f")"
                    # Only packages of the root module: no other go.mod on the way up (.github/audit is its own module).
                    [[ "$(naechster_mit "$f" go.mod)" == "." ]] || continue
                    if [[ ! -d "$d" ]] || ! compgen -G "$d/*.go" >/dev/null; then continue; fi
                    [[ -n "${pk[$d]+x}" ]] && continue
                    pk[$d]=1
                    if [[ "$d" == . ]]; then gopakete+=(.); else gopakete+=("./$d"); fi
                done
            fi
            if [[ ${#gopakete[@]} -gt 0 ]]; then
                go_pruefen "${gopakete[@]}"
            fi
        else
            hinweis "no go toolchain here — PR CI"
        fi
    fi

    # 6. Rust: cargo fmt --check in the workspaces of the changed files (sources only, works for every target).
    if [[ ${#rs[@]} -gt 0 ]]; then
        stufe "Rust (${#rs[@]} file(s))"
        if command -v cargo >/dev/null 2>&1; then
            declare -A ws=()
            for f in "${rs[@]}"; do
                d="$(naechster_mit "$f" Cargo.lock)" || d="$(naechster_mit "$f" Cargo.toml)" || continue
                [[ -n "${ws[$d]+x}" ]] && continue
                ws[$d]=1
                echo "  cargo fmt --check ($d)"
                (cd "$d" && cargo fmt --all -- --check) || rot "cargo fmt --check in $d"
            done
            hinweis "clippy and cargo test: PR CI"
        else
            hinweis "no cargo here — PR CI"
        fi
    fi

    # 7. JS/TS: biome check of the changed files, with the biome of the workspace (node_modules, no npm ci here).
    if [[ ${#js[@]} -gt 0 ]]; then
        stufe "JS/TS (${#js[@]} file(s))"
        declare -A nb=()
        for f in "${js[@]}"; do
            d="$(naechster_mit "$f" package.json)" || d="."
            nb[$d]+="${f#"$d"/}"$'\n'
        done
        for d in "${!nb[@]}"; do
            local biome=""
            for b in "$d/node_modules/.bin/biome" "$ROOT/$d/node_modules/.bin/biome"; do
                [[ -x "$b" ]] && { biome="$(cd "$(dirname "$b")" && pwd)/biome"; break; }
            done
            if [[ -z "$biome" ]]; then
                hinweis "$d: no node_modules/.bin/biome (npm ci not run) — PR CI"
                continue
            fi
            local -a dateien=()
            mapfile -t dateien < <(printf '%s' "${nb[$d]}")
            echo "  biome check ($d): ${#dateien[@]} file(s)"
            (cd "$d" && "$biome" check --no-errors-on-unmatched "${dateien[@]}") || rot "biome check in $d"
        done
        hinweis "tsc and npm test: PR CI"
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Check every pushed commit.
# ---------------------------------------------------------------------------
start=$SECONDS
for c in "${commits[@]}"; do
    bereitstellen "$c" || exit 1
    echo "pre-push: checking ${c:0:9} in the $WO"
    basis=""
    if [[ -n "$standard_basis" ]]; then
        basis="$(git merge-base "$c" "$standard_basis" 2>/dev/null)" || basis=""
    fi
    (
        cd "$DIR"
        # ---- Repo-eigener Zusatz (Kit 0.29.0): `.githooks/pre-push.zusatz` des gepushten Stands, VOR den Prüfungen.
        # Liegt er da, ist aber nicht ausführbar, bricht der Push ab: ein still übersprungener Zusatz wäre ein grüner
        # Push ohne genau die Prüfung, für die es ihn gibt.
        ZUSATZ=".githooks/pre-push.zusatz"
        if [[ -e "$ZUSATZ" ]]; then
            [[ -x "$ZUSATZ" ]] || rot "$ZUSATZ liegt da, ist aber nicht ausführbar (chmod +x)."
            echo "pre-push: repo-eigener Zusatz (.githooks/pre-push.zusatz)"
            "./$ZUSATZ" </dev/null || rot "der Zusatz ist rot."
        fi
        if [[ "${PREPUSH_VOLL:-}" == 1 ]]; then
            voll || exit 1
        else
            schnell "$basis"
        fi
    ) || exit 1
done

dauer=$((SECONDS - start))
if [[ "${PREPUSH_VOLL:-}" == 1 ]]; then
    echo "pre-push: full run green in ${dauer} s."
else
    echo
    echo "pre-push: fast checks green in ${dauer} s — the full suite runs in the PR CI (full run here: PREPUSH_VOLL=1 git push)."
    if [[ "$dauer" -gt "$FRIST" ]]; then
        echo "pre-push: note — slower than the target of ${FRIST} s; a repo extra (.githooks/pre-push.zusatz) or many affected tests? Worth a look." >&2
    fi
fi
