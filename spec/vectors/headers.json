      "id": "valid-session",
      "attack": null,
      "reason": "The headers /auth/forward sends for a browser session.",
      "input": {
        "headers": {
          "Remote-User": "anna",
          "Remote-Name": "Anna Berg",
          "Remote-Email": "anna@example.com",
          "Remote-Groups": "editors",
          "Remote-Id": "1",
          "Remote-Auth": "session"
        }
      },
      "expected": {
        "ok": true,
        "identity": {
          "user": "anna",
          "name": "Anna Berg",
          "email": "anna@example.com",
          "groups": [
            "editors"
          ],
          "id": "1",
          "auth": "session",
          "kind": "session"
        },
        "has_role": {
          "editors": true,
          "admin": false
        }
      }
