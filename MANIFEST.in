# What belongs in the sdist — and what deliberately does NOT.
#
# The wheel is built from `[tool.setuptools.packages.find]` and does not need this file.
# The sdist, by contrast, takes along by default more than anyone suspects, and less than it
# needs: by an old heuristic setuptools pulls in `tests/test_*.py`, but neither
# `tests/run_all.py` nor `tests/_kit/` nor `tests/api_surface.json`. That shipped
# a suite that cannot be started — worse than none, because it feigns a promise.
#
# Up to 0.18.0 this therefore had `prune tests`, with the reasoning: two suites need anyway
# what an sdist never contains (`git ls-files` for hygiene, `web/` for the website). That
# reasoning no longer holds. Since 0.18.0 a suite opts out itself when a prerequisite is
# missing (`tests/voraussetzung.py`, exit 77) — the repo-bound ones skip themselves cleanly
# in the sdist and name the reason instead of going red. Anyone who repackages TinySesam
# (distributions, conda, an internal wheel) can verify the build with it, and that is the
# point of a source package.
#
# So COMPLETE rather than half: `run_all.py`, `_kit/`, `voraussetzung.py`, `api_surface.json`
# belong in, otherwise nothing starts. `tests/test_packaging.py` measures exactly that.
graft tests
recursive-exclude tests __pycache__
recursive-exclude tests *.py[cod]

# What the README shows the reader should also be in the source package: `examples/showcase.py` and the
# ready-made setups under `deploy/` are linked there, and a dangling reference is more annoying in a
# tarball than on the web — there is no GitHub next to it. `web/` stays out: it is the
# generator of the project site, a repo matter, not part of the library's source.
graft examples
graft deploy
recursive-exclude examples __pycache__
recursive-exclude deploy __pycache__

# What a human looks for in the source package: the license (setuptools includes it itself), the
# version history, the reporting path for vulnerabilities and the German version of the README.
include CHANGELOG.md
include KONFIGURATION.md
include API.md
include SECURITY.md
include i18n/README.de.md
include i18n/SECURITY.de.md

# Build artifacts of a foreign working tree have no business in a source package.
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
global-exclude .DS_Store

# What .gitignore excludes does not belong in the sdist either. The `graft` lines above take ALL
# of tests/, examples/ and deploy/ that is on disk — not what is versioned.
# A `python -m build` from a used working tree thus packed an `examples/app.db` with its
# accounts and sessions, or a `deploy/forward-auth/.env` with secrets, into the source package
# (B4-13 from T-13). The release builds from a fresh checkout and was not affected — anyone who
# packages themselves was. `tests/test_packaging.py` places a dummy for every pattern from .gitignore
# in the grafted trees and checks that none ends up in the sdist; a new pattern there
# without a line here turns red. `*.egg-info/` only under the grafted trees: setuptools puts its
# own egg-info into the sdist, a `global-exclude` would exclude it as well.
global-exclude .venv/** venv/** __pycache__/** build/** dist/** _site/** .befunde-*/**
global-exclude *.db *.db-wal *.db-shm .env
recursive-exclude tests *.egg-info/**
recursive-exclude examples *.egg-info/**
recursive-exclude deploy *.egg-info/**
